pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
                steps {
                    script {
                        env.Choice = params.Choice
                        env.Approve = params.Approve
                        echo "Build Parameters: choice -> ${env.Choice} approve -> ${env.Approve}"
                    }    
                }
        }

       stage('Confirmation') {
            when {
                expression {
                    return params.AUTO_APPROVE == false || params.ENVIRONMENT.equals("prod")
                }
            }
            steps {
                timeout(time: 5, unit: "MINUTES") {
                   input message: "Are you sure to proceed?"
                }
            }
        }

        stage('Run Python') {
            steps {
                sh '''
                    pwd
                    ls -R
                    python3 scripts/main.py
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
